# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Loaded from the process working directory when running samples / pretrain.
# W&B project and run name are NOT set here — pass them as CLI flags / kwargs.

# Hugging Face Hub token (either name works; HF_TOKEN is preferred)
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API key
# https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
