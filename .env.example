# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Loaded from the process working directory when running zdeck programs.
# W&B entity / project / run name are NOT set here — set them explicitly in
# zdeck programs (or pass wandb_entity / wandb_project / wandb_name kwargs).

# Hugging Face Hub token (either name works; HF_TOKEN is preferred)
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases API key
# https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
